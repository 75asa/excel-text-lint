{
  "name": "excel-text-lint",
  "version": "0.0.0",
  "private": true,
  "description": "textlint を Office（Excel ほか）で使うための Office アドイン",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "dev": "vite",
    "build:worker": "textlint-script-compiler --textlintrc .textlintrc.json --output-dir public/textlint --mode production --metadataName excel-text-lint --metadataNamespace https://github.com/75asa/excel-text-lint --metadataHomepage https://github.com/75asa/excel-text-lint --metadataVersion 0.0.0",
    "build": "npm run build:worker && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "validate": "office-addin-manifest validate manifest.xml",
    "validate:prod": "office-addin-manifest validate dist/manifest.prod.xml",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "certs": "office-addin-dev-certs install",
    "dev-server": "vite"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@textlint/script-compiler": "^0.18.5",
    "@types/node": "^22.20.4",
    "@types/office-js": "^1.0.610",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-jtf-style": "^3.0.3",
    "textlint-rule-prh": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "kuromoji": "0.1.2"
  }
}
